+
+.quiz h2 { font-size: 1rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
+.quiz-def { font-size: 1.15rem; font-weight: 600; margin: 0 0 14px; }
+.quiz-form label { display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 4px; }
+.quiz-row { display: flex; gap: 8px; }
+.quiz-row input { flex: 1; min-width: 0; font: inherit; font-size: 1.05rem; padding: 10px 14px; min-height: 48px;
+  border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--text); }
+.quiz-row input:focus { outline: 2px solid var(--brand); outline-offset: 1px; }
+.quiz-row button { font: inherit; font-weight: 700; padding: 0 20px; min-height: 48px; border: 0; border-radius: 999px;
+  background: var(--brand); color: #fff; cursor: pointer; }
+.quiz-row button:disabled, .quiz-row input:disabled { opacity: .6; cursor: default; }
+.quiz-result { margin-top: 14px; padding: 12px 14px; border-radius: 10px; }
+.quiz-result p { margin: 0; }
+.quiz-result p + p { margin-top: 4px; }
+.quiz-result:focus { outline: none; }
+.quiz-result.is-right { background: var(--good-bg); color: var(--text); border-left: 4px solid var(--good); }
+.quiz-result.is-wrong { background: var(--bad-bg); color: var(--text); border-left: 4px solid var(--bad); }
+.quiz-verdict { font-weight: 700; }
+.quiz-order { font-size: 0.85rem; color: var(--muted); margin: 12px 0 0; }
+
+/* Home page: level choice */
+.home-start { margin: 24px 0 10px; font-size: 1.2rem; }
+.levels { display: grid; gap: 12px; text-align: left; }
+.level-card { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border-radius: var(--radius); text-decoration: none;
+  color: var(--text); background: var(--surface); border: 2px solid var(--brand); }
+.level-card strong { font-size: 1.2rem; color: var(--brand-dark); }
+.level-card span { font-size: 0.92rem; color: var(--muted); }
+.level-card-hard { background: var(--brand); }
+.level-card-hard strong, .level-card-hard span { color: #fff; }
+.level-card:hover { box-shadow: 0 2px 10px rgba(0,0,0,.12); }
+@media (min-width: 601px) { .levels { grid-template-columns: 1fr 1fr; } }
